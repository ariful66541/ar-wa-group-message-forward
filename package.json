{
  "name": "ar-whatsapp-forwarder",
  "productName": "AR WhatsApp Forwarder",
  "version": "2.7.0",
  "private": true,
  "description": "AR WA GROUP MESSAGE FORWARD - WhatsApp group message forwarder: exact original text, text only, daily schedule, password protected.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-packager . \"AR WhatsApp Forwarder\" --platform=win32 --arch=x64 --out=release --icon=build/icon.ico --overwrite --ignore=\"^/release\" --ignore=\"^/build/make-icon\""
  },
  "author": "Ariful Islam",
  "license": "MIT",
  "dependencies": {
    "qrcode": "^1.5.4",
    "whatsapp-web.js": "^1.34.8"
  },
  "devDependencies": {
    "@electron/packager": "^19.0.2",
    "electron": "^45.4.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ariful66541/ar-wa-group-message-forward.git"
  },
  "build": {
    "appId": "com.arifulislam.arwamsgforward",
    "productName": "AR WA GROUP MESSAGE FORWARD",
    "copyright": "Copyright © 2026 Ariful Islam",
    "directories": {
      "output": "installer",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "manual-wa.js",
      "manual-wa-app.js",
      "wa-engine.js",
      "preload.js",
      "lock-preload.js",
      "app/**/*",
      "build/icon.*",
      "README.txt",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "AR-WA-GROUP-MESSAGE-FORWARD-Setup-${version}.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AR WA GROUP MESSAGE FORWARD",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "deleteAppDataOnUninstall": false,
      "license": "LICENSE"
    }
  }
}
